{
  "name": "@srnoob2570/opencode-ollama-cloud",
  "version": "0.1.6",
  "description": "opencode plugin: live Ollama Cloud model catalog (from ollama.com/v1/models), kept fresh by GitHub Actions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srnoob2570/opencode-ollama-cloud.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ollama",
    "ollama-cloud",
    "provider"
  ],
  "main": "./plugin/index.ts",
  "exports": {
    ".": "./plugin/index.ts",
    "./server": "./plugin/index.ts",
    "./tui": "./plugin/tui.tsx"
  },
  "files": [
    "plugin/catalog.ts",
    "plugin/debug-sink.ts",
    "plugin/index.ts",
    "plugin/models.ts",
    "plugin/stats.ts",
    "plugin/capture.ts",
    "plugin/handoff.ts",
    "plugin/tui-display.ts",
    "plugin/tui.tsx",
    "catalog",
    "catalog.schema.json",
    "pricing.schema.json"
  ],
  "scripts": {
    "check": "bun scripts/update-catalog.ts check",
    "update": "bun scripts/update-catalog.ts update",
    "update-pricing": "bun scripts/update-pricing.ts",
    "validate": "bun scripts/validate-catalog.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.7",
    "@opencode-ai/sdk": "1.18.7",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "5.9.3"
  }
}
